{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Запуск сервера (manage.py runserver)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver",
        "127.0.0.1:8000"
      ],
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Очаково: Запуск приложения с автобраузером (run.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Тесты: Запуск Smoke-тестов (smoke_tests.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/careers/management/smoke_tests.py",
      "console": "integratedTerminal"
    },
    {
      "name": "БД: Наполнение данными (seed_ochakovo)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "seed_ochakovo"
      ],
      "console": "integratedTerminal"
    }
  ]
}
