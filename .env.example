# Окружение для «Очаково: Мастерская Вкуса» (Хакатон Открой МосПром 2026)
SECRET_KEY=django-insecure-ochakovo-production-secret-key-moscow-2026
DEBUG=True
ALLOWED_HOSTS=*

# Sber GigaChat API (Опционально: можно вводить в интерактивном окне в веб-интерфейсе перед заступлением на смену)
# Получить ключ можно в кабинете https://developers.sber.ru/
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Max

# SaluteSpeech ASR / TTS (Опционально: по умолчанию клиент использует встроенный Web Speech API и Edge-TTS)
SALUTESPEECH_AUTH_KEY=
SALUTESPEECH_SCOPE=SALUTE_SPEECH_PERS

# Локальное STT ускорение Whisper GGML (auto, vulkan, cpu)
# По умолчанию auto (приоритет отдается Vulkan GPU с автопереключением на CPU при ошибках или отсутствии GPU)
GGML_ACCELERATION=auto
GGML_VULKAN_FALLBACK_CPU=True
